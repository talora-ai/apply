COMPOSE_PROJECT_NAME=talora-apply

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
BOT_PORT=9000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Application URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MOBILE_URL=talora-apply://

# Database
POSTGRES_DB=talora_apply
POSTGRES_USER=talora
POSTGRES_PASSWORD=talora_local_password

# Laravel secrets - generated automatically by ./docker/talora init
APP_KEY=
RESUME_ENCRYPTION_KEY=
RESUME_DATA_ENCRYPTION_KEY=
BOT_SERVICE_TOKEN=
BOT_SIGNING_SECRET=

# Initial administrator
ADMIN_NAME=Talora Admin
ADMIN_EMAIL=admin@talora.local
ADMIN_PASSWORD=change-me-now
